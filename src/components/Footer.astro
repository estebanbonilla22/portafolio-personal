---
import { site } from "../data/site";

const year = new Date().getFullYear();

const socials = [
  { label: "GitHub", href: site.contact.github },
  { label: "LinkedIn", href: site.contact.linkedin },
  { label: "WhatsApp", href: site.contact.whatsapp },
  { label: "Correo", href: `mailto:${site.contact.email}` },
];
---

<footer class="site-footer">
  <div class="container-edit footer-inner">
    <div class="footer-top">
      <p class="footer-name">{site.name}</p>
      <p class="footer-note">{site.footerNote}</p>
    </div>

    <nav class="footer-socials" aria-label="Redes sociales">
      <ul>
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-bottom">
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
      <button id="back-to-top" type="button" class="back-to-top">
        Volver arriba <span aria-hidden="true">↑</span>
      </button>
    </div>
  </div>
</footer>

<script>
  document.getElementById("back-to-top")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

<style>
  .site-footer {
    background-color: var(--color-ink);
    color: var(--color-on-ink);
    padding-block: 5rem 2.5rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
  }

  .footer-note {
    color: var(--color-on-ink-muted);
    max-width: 32rem;
  }

  .footer-socials ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    list-style: none;
    border-top: 1px solid var(--color-line-dark);
    padding-top: 2rem;
  }

  .footer-socials a {
    color: inherit;
    text-decoration: none;
    font-size: 0.9375rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .footer-socials a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line-dark);
    font-size: 0.8125rem;
    color: var(--color-on-ink-muted);
  }

  .back-to-top {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    font-size: 0.8125rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.25s ease;
  }

  .back-to-top:hover {
    color: var(--color-accent);
  }
</style>
