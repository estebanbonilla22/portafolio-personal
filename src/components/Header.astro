---
import { site } from "../data/site";
---

<header id="site-header" data-theme="dark" class="header">
  <div class="header-inner container-edit">
    <a href="#inicio" class="logo">{site.name}</a>

    <nav class="nav-desktop" aria-label="Navegación principal">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="menu-toggle"
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Abrir menú</span>
      <span class="menu-toggle-bars" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <div class="mobile-menu-inner">
    <div class="mobile-menu-top container-edit">
      <span class="logo logo-on-menu">{site.name}</span>
      <button id="menu-close" class="menu-close" type="button">
        <span class="sr-only">Cerrar menú</span>
        <span aria-hidden="true">Cerrar</span>
      </button>
    </div>

    <nav class="mobile-nav container-edit" aria-label="Navegación móvil">
      <ul>
        {
          site.nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} class="mobile-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mobile-menu-bottom container-edit">
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </div>
  </div>
</div>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle")!;
  const closeBtn = document.getElementById("menu-close")!;
  const menu = document.getElementById("mobile-menu")!;
  const menuLinks = menu.querySelectorAll("a");

  function openMenu() {
    menu.hidden = false;
    requestAnimationFrame(() => menu.classList.add("is-open"));
    toggle.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    (menuLinks[0] as HTMLElement | undefined)?.focus();
  }

  function closeMenu() {
    menu.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    toggle.focus();
    window.setTimeout(() => {
      if (!menu.classList.contains("is-open")) menu.hidden = true;
    }, 320);
  }

  toggle.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn.addEventListener("click", closeMenu);

  menuLinks.forEach((link) => link.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu.classList.contains("is-open")) closeMenu();
  });

  // Header cambia de "dark" (sobre el hero) a "light" (sobre el resto del sitio).
  const heroSentinel = document.getElementById("hero-sentinel");
  if (heroSentinel) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        header.dataset.theme = entry.isIntersecting ? "dark" : "light";
      },
      { rootMargin: "-84px 0px 0px 0px", threshold: 0 }
    );
    observer.observe(heroSentinel);
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition: background-color 0.4s ease, border-color 0.4s ease;
    border-bottom: 1px solid transparent;
  }

  .header[data-theme="dark"] {
    background-color: transparent;
    color: var(--color-on-ink);
  }

  .header[data-theme="light"] {
    background-color: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom-color: var(--color-line);
    color: var(--color-ink);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5.25rem;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: inherit;
  }

  .nav-desktop {
    display: none;
  }

  .nav-desktop ul {
    display: flex;
    gap: 2.25rem;
    list-style: none;
  }

  .nav-desktop a {
    font-size: 0.875rem;
    text-decoration: none;
    color: inherit;
    position: relative;
    padding-bottom: 0.2rem;
  }

  .nav-desktop a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background-color: currentColor;
    transition: right 0.3s ease;
  }

  .nav-desktop a:hover::after,
  .nav-desktop a:focus-visible::after {
    right: 0;
  }

  @media (min-width: 64rem) {
    .nav-desktop {
      display: block;
    }
  }

  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
  }

  @media (min-width: 64rem) {
    .menu-toggle {
      display: none;
    }
  }

  .menu-toggle-bars {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 1.4rem;
  }

  .menu-toggle-bars span {
    display: block;
    height: 1px;
    background-color: currentColor;
    transition: transform 0.3s ease;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Menú móvil */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: var(--color-ink);
    color: var(--color-on-ink);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.32s ease, transform 0.32s ease;
  }

  .mobile-menu.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5.25rem;
  }

  .logo-on-menu {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .menu-close {
    background: none;
    border: none;
    color: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    letter-spacing: 0.02em;
  }

  .mobile-nav {
    margin-top: 2.5rem;
    flex: 1;
  }

  .mobile-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-link {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    text-decoration: none;
    color: inherit;
    padding: 0.35rem 0;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 0.35s ease, transform 0.35s ease;
    transition-delay: calc(var(--i) * 60ms);
  }

  .mobile-menu.is-open .mobile-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu-bottom {
    border-top: 1px solid var(--color-line-dark);
    padding-top: 1.5rem;
    font-size: 0.875rem;
  }

  .mobile-menu-bottom a {
    color: inherit;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-link {
      transition: none;
    }
  }
</style>
