---
import { site } from "../data/site";
---

<section id="inicio" class="hero">
  <div class="hero-grid container-edit">
    <div class="hero-copy">
      <p class="hero-kicker reveal" data-reveal>
        {site.role} — {site.location}
      </p>

      <h1 class="hero-name reveal" data-reveal>{site.name}</h1>

      <p class="hero-description reveal" data-reveal>
        {site.heroDescription}
      </p>

      <div class="hero-actions reveal" data-reveal>
        <a href="#proyectos" class="btn btn-primary">Ver proyectos</a>
        <a href="#contacto" class="btn btn-secondary">Contactarme</a>
      </div>
    </div>

    <div class="hero-visual reveal" data-reveal aria-hidden="true">
      <div class="code-panel">
        <div class="code-panel-head">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="code-panel-title">portafolio.ts</span>
        </div>
        <pre class="code-panel-body"><code><span class="c-kw">interface</span> <span class="c-type">Developer</span> &#123;
  name: <span class="c-type">string</span>;
  focus: <span class="c-type">string</span>[];
  status: <span class="c-str">"disponible"</span>;
&#125;<span class="cursor">|</span></code></pre>
      </div>
      <div class="hero-visual-frame"></div>
    </div>
  </div>

  <div id="hero-sentinel"></div>

  <div class="scroll-cue" aria-hidden="true">
    <span class="scroll-cue-label">Desplázate</span>
    <span class="scroll-cue-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: var(--color-ink);
    color: var(--color-on-ink);
    padding-top: 6rem;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        to right,
        color-mix(in srgb, var(--color-on-ink) 5%, transparent) 1px,
        transparent 1px
      );
    background-size: 12.5% 100%;
    opacity: 0.5;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 2rem;
    }
  }

  .hero-kicker {
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-ink-muted);
    margin-bottom: 1.5rem;
  }

  .hero-name {
    font-size: clamp(2.75rem, 7.5vw, 5.5rem);
    line-height: 0.98;
    max-width: 14ch;
  }

  .hero-description {
    margin-top: 1.75rem;
    max-width: 38ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-on-ink-muted);
  }

  .hero-actions {
    margin-top: 2.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    text-decoration: none;
    padding: 0.9rem 1.75rem;
    border: 1px solid currentColor;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .btn-primary {
    background-color: var(--color-on-ink);
    color: var(--color-ink);
    border-color: var(--color-on-ink);
  }

  .btn-primary:hover {
    background-color: transparent;
    color: var(--color-on-ink);
  }

  .btn-secondary {
    color: var(--color-on-ink);
  }

  .btn-secondary:hover {
    background-color: var(--color-on-ink);
    color: var(--color-ink);
  }

  /* Panel de código decorativo */
  .hero-visual {
    position: relative;
    display: none;
  }

  @media (min-width: 64rem) {
    .hero-visual {
      display: block;
    }
  }

  .hero-visual-frame {
    position: absolute;
    top: -1.25rem;
    right: -1.25rem;
    bottom: 2.5rem;
    left: 2.5rem;
    border: 1px solid var(--color-line-dark);
    z-index: -1;
  }

  .code-panel {
    background-color: var(--color-ink-soft);
    border: 1px solid var(--color-line-dark);
    font-family: "SFMono-Regular", ui-monospace, Menlo, monospace;
    box-shadow: 0 2rem 4rem -2rem rgba(0, 0, 0, 0.6);
  }

  .code-panel-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--color-line-dark);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background-color: var(--color-on-ink-muted);
    opacity: 0.4;
  }

  .code-panel-title {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-on-ink-muted);
  }

  .code-panel-body {
    padding: 1.5rem 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--color-on-ink);
    overflow-x: auto;
  }

  .c-kw {
    color: var(--color-accent);
  }
  .c-type {
    color: #d9cba6;
  }
  .c-str {
    color: #a3b494;
  }

  .cursor {
    display: inline-block;
    color: var(--color-accent);
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  #hero-sentinel {
    position: absolute;
    bottom: 0;
    height: 1px;
    width: 1px;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 2.25rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .scroll-cue-label {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-on-ink-muted);
  }

  .scroll-cue-line {
    width: 1px;
    height: 2.5rem;
    background-color: var(--color-on-ink-muted);
    position: relative;
    overflow: hidden;
  }

  .scroll-cue-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--color-accent);
    transform: translateY(-100%);
    animation: scrollLine 2.2s ease-in-out infinite;
  }

  @keyframes scrollLine {
    0% {
      transform: translateY(-100%);
    }
    50% {
      transform: translateY(0%);
    }
    100% {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .scroll-cue-line::after {
      animation: none;
    }
  }
</style>
