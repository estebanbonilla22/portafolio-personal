---
import "../styles/global.css";
import { seo, site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = seo.titleDefault,
  description = seo.description,
  ogImage = seo.ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />

    <script>
      // Sin JS o con "reduce motion": el contenido reveal queda visible desde el inicio.
      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (prefersReduced) {
        document.documentElement.classList.add("reduce-motion");
      }
    </script>
    <script>
      import "../scripts/animations";
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 1rem;
    z-index: 100;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 0.75rem 1.25rem;
    border-radius: 2px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }

  .skip-link:focus {
    left: 1rem;
  }
</style>
